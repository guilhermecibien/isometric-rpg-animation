{
  "name": "isometric-rpg-animation",
  "version": "0.1.0",
  "description": "Codex Agent Skill for creating, validating and integrating natural 2D isometric character animations into Phaser.js RPG games.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "import": "./dist/phaser/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.js"
    },
    "./providers/node": {
      "types": "./dist/providers/commandProvider.d.ts",
      "import": "./dist/providers/commandProvider.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "agents",
    "references",
    "scripts",
    "python",
    "schemas",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:py": "python3 -m pytest tests/py -q",
    "test:e2e": "playwright test",
    "demo": "vite examples/phaser-demo --open",
    "demo:build": "vite build examples/phaser-demo",
    "assets:demo": "python3 scripts/generate_procedural_character.py --out assets/examples/hero --validate",
    "validate:skill": "python3 scripts/validate_skill.py .",
    "predemo": "node scripts/copy-demo-assets.mjs",
    "predemo:build": "node scripts/copy-demo-assets.mjs",
    "pretest:e2e": "node scripts/copy-demo-assets.mjs"
  },
  "peerDependencies": {
    "phaser": "^3.80.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.19.43",
    "phaser": "^3.90.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}